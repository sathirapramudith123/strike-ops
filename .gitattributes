# =============================================================================
#  .gitattributes — line endings + Git LFS rules

# Normalize line endings for text files
* text=auto eol=lf
# Godot text formats
*.gd       text eol=lf
*.cs       text eol=lf diff=csharp
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.cfg      text eol=lf
*.gdshader text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.svg      text eol=lf
# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# -----------------------------------------------------------------------------
# Git LFS — large binary assets
# 3D models / source files
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
# Textures / images
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.kra  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
# Fonts
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
# Video
*.ogv filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Baked lighting / binary resources
*.lmbake filter=lfs diff=lfs merge=lfs -text
*.res    filter=lfs diff=lfs merge=lfs -text
*.scn    filter=lfs diff=lfs merge=lfs -text
# Generated detail textures (tools/make_textures.py, ~1 MB each) are stored
# as ordinary files, not LFS pointers — keep them out of the LFS rule above,
# or clones with Git LFS see them as permanently modified.
assets/textures/surfaces_*.png -filter -diff -merge binary
# Map blockouts and map art (tools/export_blockout.gd, Blender → assets/maps)
# are ordinary files too, like every other binary in this repo.
assets/blockouts/*.glb -filter -diff -merge binary
assets/maps/** -filter -diff -merge binary
assets/characters/** -filter -diff -merge binary

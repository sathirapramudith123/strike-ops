"events": [Object(InputEventKey,"physical_keycode":51)]
}
weapon_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
weapon_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
weapon_prev={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
throw_grenade={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
push_to_talk_team={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}
push_to_talk_proximity={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":66)]
}
scoreboard={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
chat_all={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
chat_team={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":89)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
toggle_perf_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="projectile"
3d_physics/layer_5="pickup"
3d_physics/layer_6="trigger"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=false
occlusion_culling/use_occlusion_culling=true
anti_aliasing/quality/use_debanding=false

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Strike Ops"
config/description="Low-spec friendly multiplayer first-person shooter with scalable graphics and voice chat."
config/version="0.9.0"
run/main_scene="res://scenes/main/main_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="FPSGame"
config/features=PackedStringArray("4.4", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.07, 0.07, 0.08, 1)
config/icon="res://icon.svg"
config/release_channel="beta"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"
driver/enable_input=true

[autoload]

SettingsManager="*res://scripts/core/settings_manager.gd"
Match="*res://scripts/core/match_manager.gd"
NetworkManager="*res://scripts/network/network_manager.gd"
VoiceChat="*res://scripts/voice/voice_chat.gd"
Audio="*res://scripts/audio/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"


[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="projectile"
3d_physics/layer_5="pickup"
3d_physics/layer_6="trigger"
3d_physics/layer_7="audio_zone"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true

[shader_globals]

surface_detail={
"type": "float",
"value": 1.0
}
surface_albedo={
"type": "sampler2DArray",
"value": "res://assets/textures/surfaces_albedo.png"
}
surface_normal={
"type": "sampler2DArray",
"value": "res://assets/textures/surfaces_normal.png"
}

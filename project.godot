; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FPS Game"
config/description="Low-spec friendly multiplayer first-person shooter with scalable graphics and voice chat."
config/version="0.1.0"
run/main_scene="res://scenes/main/main_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="FPSGame"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.07, 0.07, 0.08, 1)
config/icon="res://icon.svg"

[audio]

driver/enable_input=true
buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

SettingsManager="*res://scripts/core/settings_manager.gd"
NetworkManager="*res://scripts/network/network_manager.gd"
VoiceChat="*res://scripts/voice/voice_chat.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
slide={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
reload={
